# Configurações da API Shopee
# Obtenha suas credenciais em: https://open.shopee.com.br/
SHOPEE_AFFILIATE_ID=seu_affiliate_id_aqui
SHOPEE_API_KEY=sua_api_key_aqui

# Configurações da API Google Gemini
# Obtenha sua chave em: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=sua_gemini_api_key_aqui

# Configurações Django (para produção)
SECRET_KEY=seu_secret_key_django_aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
